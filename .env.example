# Docker / DSM template. Copy to .env, fill placeholders, then keep .env private.
# Generate SECRET_KEY: openssl rand -hex 32
# Generate ENCRYPTION_KEY using the built image (see README.md).
# Keep both keys unchanged across rebuilds, restarts, and NAS moves.

# --- App ---
SECRET_KEY=replace-with-a-random-signing-key
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DEBUG=False
# ONLINE keeps registered login and the separate nickname-only guest entrance.
# LOCAL additionally supports local username/password login.
AUTH_MODE=ONLINE

# --- Network: local computer ---
# Container always listens on 8000. Update BOTH URLs when HOST_PORT changes.
# Use 0.0.0.0 only when LAN / reverse-proxy access is intended.
BIND_IP=127.0.0.1
HOST_PORT=8000
FRONTEND_URL=http://127.0.0.1:8000
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/spotify/callback
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# --- DSM / HTTPS reverse proxy: replace the values above ---
# BIND_IP=0.0.0.0
# FRONTEND_URL=https://music.example.com
# SPOTIFY_REDIRECT_URI=https://music.example.com/api/v1/auth/spotify/callback
# COOKIE_SECURE=True
# Trust ONLY the actual proxy peer IP as seen by the app container.
# This lets Uvicorn resolve real client IPs for source rate limits. Never use *
# on an app port reachable directly by untrusted clients. See README.md.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- PostgreSQL: db is the Compose service name ---
# Use the same generated password in POSTGRES_PASSWORD and DATABASE_URL.
# A hex password avoids URL-escaping and Compose interpolation problems.
POSTGRES_USER=crowdroom
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=crowdroom
DATABASE_URL=postgresql://crowdroom:replace-with-a-random-database-password@db:5432/crowdroom
# Compose persists PostgreSQL in pgdata and avatars in avatars. Back up both.

# --- Spotify: app credentials, not a Spotify login password ---
# Register SPOTIFY_REDIRECT_URI exactly in the Spotify developer dashboard.
# Spotify accepts HTTP loopback IPs; localhost is not an accepted callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PLAYBACK_POLL_INTERVAL_SECONDS=3

# --- Metadata cache ---
METADATA_CACHE_TTL_SECONDS=86400
METADATA_CACHE_MAX_SIZE=2048

# --- Optional LAN QR display device shared secret ---
# Generate with openssl rand -hex 32 if using a compatible display device.
DEVICE_AUTH_TOKEN=

# --- API docs gate ---
DOCS_ALLOWED_HOSTS=127.0.0.1,::1
# Keep False unless a trusted proxy strips/replaces incoming X-Forwarded-For.
# This setting affects docs access, not the application's source rate limits.
DOCS_TRUST_PROXY=False
