# HTTPS production backend template. Copy to backend/.env for native hosting.
# For Docker / DSM use the root .env.example and its HTTPS settings instead.
SECRET_KEY=replace-with-a-random-signing-key
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
# Generate fresh keys once; retain them when upgrading or moving the database.
# SECRET_KEY: openssl rand -hex 32
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEBUG=False
AUTH_MODE=ONLINE

COOKIE_SECURE=True
COOKIE_SAMESITE=lax
FRONTEND_URL=https://music.example.com

# PostgreSQL hostname must be reachable from the backend runtime.
DATABASE_URL=postgresql://crowdroom:replace-with-a-random-database-password@db-host:5432/crowdroom

# Register this exact public HTTPS callback in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://music.example.com/api/v1/auth/spotify/callback
PLAYBACK_POLL_INTERVAL_SECONDS=3

# Trust only the actual reverse-proxy peer IP. Replace when the proxy is remote
# or reaches the container through a Docker bridge. Never expose a wildcard trust
# setting to direct traffic. Native Uvicorn needs --forwarded-allow-ips as well.
FORWARDED_ALLOW_IPS=127.0.0.1

METADATA_CACHE_TTL_SECONDS=86400
METADATA_CACHE_MAX_SIZE=2048

# Optional LAN QR display device. Generate: openssl rand -hex 32
DEVICE_AUTH_TOKEN=

DOCS_ALLOWED_HOSTS=127.0.0.1,::1
# Enable only if the proxy strips/replaces incoming X-Forwarded-For.
DOCS_TRUST_PROXY=False
