# Native backend development template. Copy to backend/.env.
# For the full Docker stack use the root .env.example instead.
# Generate SECRET_KEY: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-signing-key
DEBUG=True
AUTH_MODE=LOCAL

# Keep these values stable so sessions and encrypted Spotify tokens survive.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# httpOnly cookies for local HTTP; use the same host in both browser tabs.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Vite frontend (run pnpm dev --host 127.0.0.1).
FRONTEND_URL=http://127.0.0.1:5173

# Empty selects SQLite for LOCAL or PostgreSQL for ONLINE.
# To use a particular database, set the complete DSN instead.
# DATABASE_URL=postgresql://crowdroom:password@127.0.0.1:5432/crowdroom
DATABASE_URL=

# Exact callback registered in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/spotify/callback
PLAYBACK_POLL_INTERVAL_SECONDS=3

# Dedicated PostgreSQL test database, never a live room database.
# CROWDROOM_TEST_POSTGRES_URL=postgresql://user:password@db:5432/crowdroom_test

METADATA_CACHE_TTL_SECONDS=86400
METADATA_CACHE_MAX_SIZE=2048

# Optional LAN QR display device. Generate: openssl rand -hex 32
DEVICE_AUTH_TOKEN=

DOCS_ALLOWED_HOSTS=127.0.0.1,::1
DOCS_TRUST_PROXY=False
# Used by the Docker Uvicorn command; native Uvicorn needs the equivalent flag.
FORWARDED_ALLOW_IPS=127.0.0.1
