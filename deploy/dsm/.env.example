# Copy to .env on the NAS. Commit this template only; keep .env private.
CROWDROOM_IMAGE=crowdroom:dsm-20261026
BIND_IP=0.0.0.0
HOST_PORT=3323

AUTH_MODE=ONLINE
DEBUG=False
# For a NEW installation: openssl rand -hex 32
# When moving an existing installation, preserve BOTH original keys instead.
SECRET_KEY=replace-with-a-random-signing-key
# Generate with the imported image; see README.md.
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

POSTGRES_USER=crowdroom
# Generate with openssl rand -hex 32; hex avoids DSN escaping problems.
# Compose builds DATABASE_URL from these three POSTGRES values.
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=crowdroom

FRONTEND_URL=https://music.kylermaker.com
PUBLIC_URL=https://music.kylermaker.com
SPOTIFY_REDIRECT_URI=https://music.kylermaker.com/api/v1/auth/spotify/callback
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Existing nginx host. Verify this is the proxy peer seen by the app container;
# Docker/NAS networking may present a different address. Trust only that peer.
# Never use * or Cloudflare public ranges for a direct nginx -> NAS connection.
FORWARDED_ALLOW_IPS=192.168.1.123
DOCS_ALLOWED_HOSTS=127.0.0.1,::1
DOCS_TRUST_PROXY=False

# Spotify developer app credentials, not your Spotify account password.
# Preserve existing values when migrating. Register the exact callback above.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PLAYBACK_POLL_INTERVAL_SECONDS=3
